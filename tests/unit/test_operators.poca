(function() {

  return {
    nullish_coalescing_assignment: [
      () => {
        let a = 5;
        //a ??= 5;
        Test.assertType(a, 'Number');
        Test.assertEqual(a, 5);
      },

      () => {
        let h = {};
        h?.a ??= 5;
        //h['a'] = 5;
        Test.assert(contains(h, 'a'));
        Test.assertType(h.a, 'Number');
        Test.assertEqual(h.a, 5);
      }
    ],

    // Used to read a regular expression slot with a register number and to pass
    // no regular expression at all. Like RegExp.test, the operator matches from
    // the start of the string on, and ^...$ is what makes it cover all of it.
    regexp_match_operator: [
      () => Test.assertEqual('abc' =~= /abc/, 1),
      () => Test.assertEqual('abc' =~= /a/, 1),
      () => Test.assertEqual('abcd' =~= /abc/, 1),
      () => Test.assertEqual('abc' =~= /b/, 0),
      () => Test.assertEqual('abc' =~= /x/, 0),
      () => Test.assertEqual('abc' =~= /^abc$/, 1),
      () => Test.assertEqual('abcd' =~= /^abc$/, 0),
      () => Test.assertEqual('abc' !~= /abc/, 0),
      () => Test.assertEqual('abc' !~= /b/, 1),
      () => Test.assertEqual('abc' !~= /x/, 1),
      () => {
        let s = 'abc', r = /ab/;
        Test.assertEqual(s =~= r, 1);
        Test.assertEqual(s !~= r, 0);
      },
      () => Test.assertEqual('abc' =~= 'abc', 0)
    ],
  }

})();
